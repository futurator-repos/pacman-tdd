{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/main.ts", "scripts/*.ts", "tests/e2e/**/*.spec.ts", "src/**/*.test.ts"],
  "project": ["src/**/*.ts", "assets/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "ignoreDependencies": ["allure-commandline"],
  "ignoreBinaries": ["allure"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error"
  }
}
