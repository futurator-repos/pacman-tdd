{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "scripts/*.js", "tests/e2e/**/*.spec.ts", "src/**/*.test.ts"],
  "project": ["src/**/*.ts", "assets/**/*.ts", "scripts/**/*.{ts,js}", "tests/**/*.ts"],
  "ignoreBinaries": ["java"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error"
  }
}
