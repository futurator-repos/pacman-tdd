node_modules/
dist/
coverage/
*.tsbuildinfo

# Test output
allure-results/
allure-report/
playwright-report/
test-results/
.vitest-cache/

# Editor / OS
.DS_Store
*.log
# ...except the captured RED runs. These are evidence, not noise: the charter
# tells a reader to check them, and ten commit messages cite them by name. A
# generic *.log rule silently swallowed the whole trail once already.
!docs/tdd-evidence/*.log
.idea/
.vscode/*
!.vscode/extensions.json

.env
.env.*
!.env.example

# BMAD / TEA (installed with `npx bmad-method install --modules tea --tools claude-code`)
# The skills are ~10MB of vendored upstream files - reinstall rather than clone them.
# _bmad/ IS committed: it holds the pinned config and module metadata that make the
# reinstall reproducible.
.claude/skills/
_bmad-output/
