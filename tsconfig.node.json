{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@render/*": ["./src/render/*"],
      "@platform/*": ["./src/platform/*"],
      "@assets/*": ["./assets/*"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.ts", "scripts/**/*.ts"]
}
